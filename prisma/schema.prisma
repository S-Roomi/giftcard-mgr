// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Category {
    id           Int           @id @default(autoincrement())
    name         String        @unique
    createdAt    DateTime      @default(now())
    giftCards    GiftCard[]
    transactions Transaction[]
}

model GiftCard {
    id                 Int                @id @default(autoincrement())
    code               String
    pin                String?
    balance            Float
    expiresAt          DateTime?
    notes              String?
    categoryId         Int
    category           Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt
    transactionEntries TransactionEntry[]

    @@index([categoryId])
}

// One planner spend in a category. Amounts are rounded to cents like GiftCard.balance.
model Transaction {
    id         Int                @id @default(autoincrement())
    categoryId Int
    category   Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    amount     Float
    note       String?
    userId     Int?
    user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
    createdAt  DateTime           @default(now())
    entries    TransactionEntry[]

    @@index([categoryId, createdAt])
    @@index([userId])
}

// The portion of a transaction taken from one card. cardLabel keeps history readable
// after the card is deleted and holds only a masked suffix, never the full code or PIN.
model TransactionEntry {
    id            Int         @id @default(autoincrement())
    transactionId Int
    transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    giftCardId    Int?
    giftCard      GiftCard?   @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
    cardLabel     String
    amount        Float
    balanceAfter  Float

    @@index([transactionId])
    @@index([giftCardId])
}

model User {
    id           Int           @id @default(autoincrement())
    username     String        @unique
    passwordHash String
    sessions     Session[]
    transactions Transaction[]
    createdAt    DateTime      @default(now())
}

model Session {
    tokenHash String   @id
    userId    Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@index([expiresAt])
    @@index([userId])
}

// One persistent login throttle shared across instances; independent of proxy headers.
model LoginThrottle {
    id        Int      @id
    attempts  Int
    resetAt   DateTime
}
