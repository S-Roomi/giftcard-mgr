// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Category {
    id        Int        @id @default(autoincrement())
    name      String     @unique
    createdAt DateTime   @default(now())
    giftCards GiftCard[]
}

model GiftCard {
    id         Int       @id @default(autoincrement())
    code       String
    pin        String?
    balance    Float
    expiresAt  DateTime?
    notes      String?
    categoryId Int
    category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    @@index([categoryId])
}

model User {
    id           Int       @id @default(autoincrement())
    username     String    @unique
    passwordHash String
    sessions     Session[]
    createdAt    DateTime  @default(now())
}

model Session {
    tokenHash String   @id
    userId    Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@index([expiresAt])
    @@index([userId])
}

// One persistent login throttle shared across instances; independent of proxy headers.
model LoginThrottle {
    id        Int      @id
    attempts  Int
    resetAt   DateTime
}
