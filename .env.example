DATABASE_URL="file:./db.sqlite"
# Must match the browser's address. For LAN access, use http://<device-ip>:6565.
APP_URL="http://localhost:3000"
# Themes: default, rosepine, catppuccin (Mocha), catppuccin-mocha,
# catppuccin-frappe, catppuccin-macchiato, catppuccin-latte (light).
# Restart the app after changing this.
APP_THEME="default"
