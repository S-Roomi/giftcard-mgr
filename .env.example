DATABASE_URL="file:/app/data/db.sqlite"
# Must match the browser's address. For LAN access, use http://<device-ip>:6565.
APP_URL="http://localhost:3000"
# Themes: ledger (default, black), default (slate), rosepine, catppuccin (Mocha),
# catppuccin-mocha, catppuccin-frappe, catppuccin-macchiato, catppuccin-latte (light).
# Restart the app after changing this.
APP_THEME="ledger"
